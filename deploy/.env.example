# WSF Semantic Engine : Environment Template
#
# Copy to .env and fill in real values. .env is gitignored and MUST NOT
# be committed. All secrets are injected from the environment.

# ----- Engine -----
WSF_HOST=0.0.0.0
WSF_PORT=8080
WSF_API_PREFIX=/v1
WSF_CORS_ORIGINS=*

# ----- Store backend: memory | postgresql | sqlite | neo4j | mongodb -----
WSF_STORE_BACKEND=postgresql

# ----- PostgreSQL -----
WSF_PG_DATABASE=wsf
WSF_PG_USER=wsf
WSF_PG_PASSWORD=
WSF_PG_SSL=false

# ----- SQLite (embedded; no service required) -----
WSF_SQLITE_PATH=./wsf.db
WSF_SQLITE_WAL=true

# ----- Neo4j -----
WSF_NEO4J_USERNAME=neo4j
WSF_NEO4J_PASSWORD=
WSF_NEO4J_DATABASE=neo4j

# ----- MongoDB -----
WSF_MONGO_USER=wsf
WSF_MONGO_PASSWORD=
WSF_MONGO_DATABASE=wsf
